<Window x:Class="AnalogtoKey.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AnalogtoKey" Height="170" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#252526" Foreground="White"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="Enter text:" Foreground="#CCCCCC"
                   FontFamily="Segoe UI" FontSize="13" Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox" Height="28" Background="#333" Foreground="White"
                 BorderBrush="#555" FontFamily="Segoe UI" FontSize="13"
                 Padding="6,4" KeyDown="InputBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="70" Height="28" Margin="0,0,8,0"
                    Background="#1565C0" Foreground="White" BorderBrush="#1565C0"
                    Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" Height="28"
                    Background="#333" Foreground="White" BorderBrush="#555"
                    Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
